        ];

        // Format Rupiah
        function formatRupiah(number) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
        }

        // Render Produk
        function renderProducts(filter = 'all') {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = '';

            const filtered = filter === 'all' ? products : products.filter(p => p.brand.toLowerCase() === filter.toLowerCase());

            filtered.forEach(product => {
                grid.innerHTML += `
                    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-xl transition duration-300 flex flex-col">
                        <div class="relative bg-gray-100 overflow-hidden group h-56">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            <span class="absolute top-3 left-3 bg-gray-900/80 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">${product.brand}</span>
                            <span class="absolute top-3 right-3 bg-emerald-500 text-white text-[10px] font-bold px-2.5 py-1 rounded-full">Stok: ${product.stock} pasang</span>
                        </div>
                        <div class="p-5 flex flex-col flex-grow">
                            <h3 class="font-bold text-gray-900 text-lg mb-1 leading-snug">${product.name}</h3>
                            <p class="text-xs text-red-600 font-semibold mb-3"><i class="fa-solid fa-layer-group me-1"></i> Model: ${product.model}</p>
                            <p class="text-xs text-gray-500 line-clamp-2 mb-4">${product.spec}</p>
                            
                            <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] text-gray-400 font-medium block">Harga EDAN</span>
                                    <span class="text-lg font-black text-gray-900">${formatRupiah(product.price)}</span>
                                </div>
                                <button onclick="openModal(${product.id})" class="bg-red-600 hover:bg-red-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition shadow-sm">
                                    Detail / Beli
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        // Filter Kategori
        function filterCategory(cat) {
            renderProducts(cat);
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.className = "cat-btn border px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white text-gray-700 border-gray-200 hover:bg-gray-100 transition";
            });
            event.target.className = "cat-btn border px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-gray-900 text-white border-gray-900 transition";
        }

        // Buka Modal Detail & Order WA
        function openModal(id) {
            const product = products.find(p => p.id === id);
            const content = document.getElementById('modal-content');

            content.innerHTML = `
                <div class="space-y-4">
                    <img src="${product.image}" class="w-full h-48 object-cover rounded-xl border border-gray-100">
                    <div>
                        <span class="text-xs font-bold text-red-600 uppercase tracking-wide">${product.brand}</span>
                        <h3 class="text-xl font-black text-gray-900">${product.name}</h3>
                        <p class="text-2xl font-black text-gray-900 mt-1">${formatRupiah(product.price)}</p>
                    </div>

                    <div class="bg-gray-50 p-3 rounded-xl border border-gray-200 text-xs text-gray-600 space-y-1">
                        <p><strong>Model:</strong> ${product.model}</p>
                        <p><strong>Spesifikasi:</strong> ${product.spec}</p>
                        <p><strong>Sisa Stok:</strong> ${product.stock} Pasang</p>
                    </div>

                    <form onsubmit="sendToWA(event, '${product.name}', ${product.price})">
                        <div class="mb-3">
                            <label class="block text-xs font-bold text-gray-700 mb-1">Pilih Ukuran (EU Size):</label>
                            <select id="size-select" required class="w-full border border-gray-300 rounded-xl p-2.5 text-xs font-semibold focus:ring-2 focus:ring-red-500 focus:outline-none">
                                ${product.sizes.map(s => `<option value="${s}">Ukuran ${s}</option>`).join('')}
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="block text-xs font-bold text-gray-700 mb-1">Metode Pembayaran:</label>
                            <select id="payment-select" required class="w-full border border-gray-300 rounded-xl p-2.5 text-xs font-semibold focus:ring-2 focus:ring-red-500 focus:outline-none">
                                <option value="Cash / Tunai">Cash / Tunai / COD</option>
                                <option value="Transfer Bank BCA">Transfer Bank BCA</option>
                                <option value="Transfer Bank Mandiri (BM)">Transfer Bank Mandiri (BM)</option>
                                <option value="Transfer Bank BSI">Transfer Bank BSI</option>
                                <option value="E-Wallet DANA">E-Wallet DANA</option>
                                <option value="E-Wallet OVO">E-Wallet OVO</option>
                                <option value="E-Wallet GOPAY">E-Wallet GOPAY</option>
                                <option value="Angsuran / Paylater">Angsuran / Cicilan (Paylater)</option>
                            </select>
                        </div>

                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl flex items-center justify-center gap-2 transition shadow-lg">
                            <i class="fa-brands fa-whatsapp text-lg"></i>
                            <span>Pesan via WhatsApp Sekarang</span>
                        </button>
                    </form>
                </div>
            `;

            document.getElementById('modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modal').classList.add('hidden');
        }

        // Redirect WA EDAN STORE
        function sendToWA(e, name, price) {
            e.preventDefault();
            const size = document.getElementById('size-select').value;
            const payment = document.getElementById('payment-select').value;
            
            const message = `Halo EDAN STORE! Saya ingin memesan sepatu berikut:\n\n` +
                            `📌 *Nama Sepatu:* ${name}\n` +
                            `💰 *Harga:* ${formatRupiah(price)}\n` +
                            `👟 *Ukuran:* EU ${size}\n` +
                            `💳 *Metode Pembayaran:* ${payment}\n\n` +
                            `Mohon konfirmasi ketersediaan stok & total tagihannya. Terima kasih!`;
            
            const waUrl = `https://wa.me/6285794793050?text=${encodeURIComponent(message)}`;
            window.open(waUrl, '_blank');
        }

        // Init App
        window.onload = function() {
            renderProducts();
        };
    </script>
</body>
